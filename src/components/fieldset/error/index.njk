---
title: Fieldset with a hint and error message – Fieldset
layout: layout-example-form.njk
stylesheets:
- ../address-group/address-wrapper.css
---

{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/hint/macro.njk" import govukHint %}
{% from "govuk/components/input/macro.njk" import govukInput %}

<div class="govuk-form-group govuk-form-group--error">
  {% call govukFieldset({
    legend: {
      text: "What is your address?",
      classes: "govuk-fieldset__legend--l",
      isPageHeading: true
    },
    describedBy: "address-hint address-error",
    role: "group"
  }) %}

    {{ govukHint({
      id: "address-hint",
      text: "We’ll send your licence to this address"
    }) }}

    {{ govukErrorMessage({
      id: "address-error",
      text: "Enter your address"
    }) }}

    {{ govukInput({
      label: {
        text: "Address line 1"
      },
      classes: "govuk-input--error",
      id: "address-line-1",
      name: "addressLine1",
      autocomplete: "address-line1"
    }) }}

    {{ govukInput({
      label: {
        text: "Address line 2 (optional)"
      },
      id: "address-line-2",
      name: "addressLine2",
      autocomplete: "address-line2"
    }) }}

    {{ govukInput({
      label: {
        text: "Town or city"
      },
      classes: "govuk-!-width-two-thirds govuk-input--error",
      id: "address-town",
      name: "addressTown",
      autocomplete: "address-level2"
    }) }}

    {{ govukInput({
      label: {
        text: "Postcode"
      },
      classes: "govuk-input--width-10 govuk-input--error",
      id: "address-postcode",
      name: "addressPostcode",
      autocomplete: "postal-code"
    }) }}

  {% endcall %}
</div>
